{
  "name": "cango-common",
  "version": "1.0.0",
  "description": "Vue 3 component library for Cango common UI components.",
  "author": "jinshenmin <jinshenmin@cangoonline.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cango-common.umd.cjs",
  "module": "./dist/cango-common.es.js",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "import": "./dist/cango-common.es.js",
      "require": "./dist/cango-common.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "npm run dev",
    "build": "vite build",
    "lint": "eslint .",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@vitejs/plugin-vue": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "globals": "latest",
    "less": "latest",
    "vite": "latest",
    "vue": "latest"
  },
  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 9.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
